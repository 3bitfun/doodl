{
  "name": "doodl",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:party": "partykit dev",
    "dev:all": "concurrently \"npm run dev:party\" \"npm run dev\"",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && gh-pages -d dist",
    "deploy:party": "partykit deploy"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.5",
    "partykit": "^0.0.115",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "partysocket": "^1.3.0"
  },
  "description": "A real-time multiplayer drawing and guessing game built with Vite, vanilla JavaScript, Tailwind CSS, and Supabase Realtime Broadcast.",
  "main": "postcss.config.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/3bitfun/doodl.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/3bitfun/doodl/issues"
  },
  "homepage": "https://github.com/3bitfun/doodl#readme"
}
